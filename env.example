# ============================================
# Environment Configuration
# ============================================
# Copy this file to .env.local and update values
# For production, use .env.production.local

# ============================================
# ENVIRONMENT MODE
# ============================================
# Set to 'development' or 'production'
NODE_ENV=development

# ============================================
# API CONFIGURATION
# ============================================
# Development API URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# Production API URL (uncomment and set for production)
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api

# API Request Timeout (milliseconds)
NEXT_PUBLIC_API_TIMEOUT=10000

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Application Name
NEXT_PUBLIC_APP_NAME=FullStack App

# Development Frontend URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production Frontend URL (uncomment and set for production)
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

# ============================================
# AUTHENTICATION CONFIGURATION
# ============================================
# Token refresh threshold (milliseconds) - 5 minutes
NEXT_PUBLIC_TOKEN_REFRESH_THRESHOLD=300000

# Max retry attempts for failed API calls
NEXT_PUBLIC_MAX_RETRY_ATTEMPTS=3

# ============================================
# QUICK SWITCH: DEVELOPMENT
# ============================================
# To switch to development, set:
# NODE_ENV=development
# NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# QUICK SWITCH: PRODUCTION
# ============================================
# To switch to production, set:
# NODE_ENV=production
# NEXT_PUBLIC_API_BASE_URL=https://api.yourdomain.com/api
# NEXT_PUBLIC_APP_URL=https://yourdomain.com

