# Production Environment Configuration
# Copy this to .env.production.local for production
# Replace YOUR_API_DOMAIN and YOUR_FRONTEND_DOMAIN with your actual domains

NODE_ENV=production

# API Configuration - REPLACE WITH YOUR PRODUCTION API URL
NEXT_PUBLIC_API_BASE_URL=https://YOUR_API_DOMAIN/api
NEXT_PUBLIC_API_TIMEOUT=10000

# Application Configuration - REPLACE WITH YOUR PRODUCTION FRONTEND URL
NEXT_PUBLIC_APP_NAME=FullStack App
NEXT_PUBLIC_APP_URL=https://YOUR_FRONTEND_DOMAIN

# Authentication Configuration
NEXT_PUBLIC_TOKEN_REFRESH_THRESHOLD=300000
NEXT_PUBLIC_MAX_RETRY_ATTEMPTS=3

